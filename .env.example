# Copy to .env.local (gitignored) and fill values. Never commit real values.

# Public: safe for the browser; authorization is enforced by Supabase RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Server-only (optional in Phase 1; required by later phases).
# SUPABASE_SERVICE_ROLE_KEY=
# MODEL_PROVIDER=
# MODEL_API_KEY=

DEMO_MODE=true
MAX_PAGES_PER_WORKSPACE=100
MAX_MODEL_COST_USD_PER_RUN=10

# Seeded demo accounts (used by integration + e2e tests; values live only
# in .env.local and in the Supabase auth store).
DEMO_USER_A_EMAIL=
DEMO_USER_A_PASSWORD=
DEMO_USER_B_EMAIL=
DEMO_USER_B_PASSWORD=
