# Copy to .env.local (gitignored) and fill values. Never commit real values.

# Public: safe for the browser; authorization is enforced by Supabase RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Server / worker only — never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL (session mode / db.<ref>.supabase.co:5432). Do NOT use
# the transaction pooler (port 6543) for pg-boss workers.
DATABASE_URL=

DEMO_MODE=true
MAX_PAGES_PER_WORKSPACE=100
MAX_UPLOAD_BYTES=26214400
MAX_MODEL_COST_USD_PER_RUN=10
PHASE3_SPEND_CEILING_USD=10
MAX_EXTRACT_PAGES_PER_RUN=40
MAX_MODEL_CALLS_PER_RUN=20
MAX_INPUT_TOKENS_PER_CALL=12000
MAX_OUTPUT_TOKENS=4000
PARSE_TIMEOUT_MS=60000
PARSE_CONCURRENCY=1

# Optional live provider (server/worker only). When absent/empty, MockProvider is used.
# Never commit real keys. Never use NEXT_PUBLIC_* for this value.
# Application-side Phase 3 ceiling is PHASE3_SPEND_CEILING_USD above — also configure
# an OpenAI project budget/alert manually. store:false ≠ contractual ZDR.
OPENAI_API_KEY=
OPENAI_EXTRACT_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_EMBED_MODEL=text-embedding-3-small

# Standalone live-evaluation commands refuse to run unless explicitly set to 1
# for that command. Never enable this in CI, Playwright, or ordinary startup.
PHASE3_LIVE_EVAL=0

# Seeded demo accounts (integration + e2e only; live in .env.local).
DEMO_USER_A_EMAIL=
DEMO_USER_A_PASSWORD=
DEMO_USER_B_EMAIL=
DEMO_USER_B_PASSWORD=
