# Copy to .env.local (gitignored) and fill values. Never commit real values.

# Public: safe for the browser; authorization is enforced by Supabase RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Server / worker only — never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL (session mode / db.<ref>.supabase.co:5432). Do NOT use
# the transaction pooler (port 6543) for pg-boss workers.
DATABASE_URL=

DEMO_MODE=true
MAX_PAGES_PER_WORKSPACE=100
MAX_UPLOAD_BYTES=26214400
MAX_MODEL_COST_USD_PER_RUN=10
PARSE_TIMEOUT_MS=60000
PARSE_CONCURRENCY=1

# Seeded demo accounts (integration + e2e only; live in .env.local).
DEMO_USER_A_EMAIL=
DEMO_USER_A_PASSWORD=
DEMO_USER_B_EMAIL=
DEMO_USER_B_PASSWORD=
